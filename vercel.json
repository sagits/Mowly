{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm build:web",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/customer/service/:id", "destination": "/customer/service/%5Bid%5D" },
    { "source": "/customer/chat/:id", "destination": "/customer/chat/%5Bid%5D" },
    { "source": "/pro/jobs/:id/recommend", "destination": "/pro/jobs/%5Bid%5D/recommend" },
    { "source": "/pro/jobs/:id", "destination": "/pro/jobs/%5Bid%5D" },
    { "source": "/pro/calendar/:date", "destination": "/pro/calendar/%5Bdate%5D" }
  ]
}
